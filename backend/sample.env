# ===============================
# 🍳 Breakfast Backend - .env File
# ===============================

# Django & Server
SECRET_KEY=your_django_secret_key
DEBUG=True
ENVIORNMENT=Testing

# Database
POSTGRES_DB=breakfast_db
POSTGRES_USER=breakfast_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URLs
FRONTEND_URL=http://localhost:3000/home
BACKEND_URL=http://127.0.0.1:8005

# Email (SMTP - Gmail Example)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_USE_TLS=True
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_app_password
ADMIN_EMAIL=your_email@example.com
# NOTE: Please add your email credentials for email notifications.

# Stripe
STRIPE_API_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000
OTP_TIMEOUT=3

# Misc
VAT_PERCENTAGE=10
LOW_STOCK_THRESHOLD=5
